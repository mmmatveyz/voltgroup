# ====================================================
# VoltGroup Server — Пример переменных окружения
# ====================================================
# Скопируйте этот файл в .env и заполните реальными значениями:
# cp .env.example .env
#
# ВНИМАНИЕ: Файл .env содержит секреты и ни при каких условиях
# не должен попадать в репозиторий (он добавлен в .gitignore).
# ====================================================

# 1. Telegram Bot API
# Токен бота, полученный у @BotFather в Telegram.
# Без него бот не сможет запускаться и отправлять уведомления о заявках.
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID мастера / администратора (целое число).
# Единственный доверенный получатель заявок и пользователь админ-бота.
CHAT_ID=123456789

# Секретный токен для проверки подлинности входящих вебхуков от Telegram.
# Передаётся Telegram в заголовке X-Telegram-Bot-Api-Secret-Token.
# Если не задан, входящие вебхуки будут отклоняться с кодом 403.
TELEGRAM_SECRET_TOKEN=change_this_to_a_secure_random_secret_string

# 2. Google Sheets CRM
# Полная ссылка на Google Таблицу с объектами и сметами.
# Таблица должна быть предварительно расшарена на email сервисного аккаунта.
SHEET_URL=https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit

# JSON-ключ сервисного аккаунта Google Cloud (в одну строку).
# Скачивается из Google Cloud Console -> IAM -> Service Accounts -> Keys.
# Пример структуры: {"type": "service_account", "project_id": "...", ...}
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"voltgroup-crm","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"sa@voltgroup-crm.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# 3. Безопасность и CORS
# Список разрешённых доменов (Origin) через запятую для кросс-доменных запросов (CORS).
# По умолчанию в коде включены: https://voltgroup-spb.ru, https://www.voltgroup-spb.ru,
# а также адреса локальной разработки: http://localhost:8000, http://127.0.0.1:8000, http://localhost:5500.
# Вы можете дополнить или переопределить их через эту переменную.
ALLOWED_ORIGINS=https://voltgroup-spb.ru,https://www.voltgroup-spb.ru,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500

# 4. Хранилище фотографий Cloudinary (задача 012, пункт № 9 AUDIT.md)
# URL для загрузки фотографий объектов мастером через Telegram-бота.
# Формат: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
# Получается в консоли Cloudinary (Dashboard -> API Keys -> API Environment variable).
# Если переменная не задана, бот сообщит мастеру о необходимости настройки хранилища.
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyzA@my-cloud-name

# 5. Локальный запуск и логирование (опционально)
# Порт для локального запуска сервера (по умолчанию 8000, на Render задаётся платформой).
PORT=8000

# Каталог для записи файлов логов (по умолчанию ./logs/ внутри проекта).
# LOG_DIR=logs

